cpp
#include "Rectangle.h"
#include <iostream>

Rectangle::Rectangle(double a, double b)
{
    if (a <= 0 || b <= 0) 
    {
        throw GeometricException("Ошибка создания прямоугольника: стороны не могут быть отрицательными");
    }
    sides[0] = a; sides[1] = b; sides[2] = a; sides[3] = b;
    print();
}

void Rectangle::print() const 
{
    std::cout << "Прямоугольник (стороны: " << sides[0] << ", " << sides[1] << ") создан\n" << std::endl;
}
