#include <iostream>
#include "Triangle.h"

int main() 
{
    try 
    {
        double sides[] = {3, 4, 5};
        double angles[] = {30, 60, 90};
        Triangle tri(sides[0], sides[1], sides[2], angles[0], angles[1], angles[2]);
    } catch (const GeometricException& e) 
    {
        std::cerr << "Ошибка: " << e.what() << std::endl;
    }

    try 
    {
        double sides2[] = {6, 8, 10};
